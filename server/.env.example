# PEN Academy backend environment template.
# Copy this file to .env (the repository .gitignore already excludes .env) and
# adjust values for your environment.

# Port the Express API listens on. The Vite dev server proxies /api to this port.
PORT=5000

# MongoDB connection string. Local default:
MONGO_URI=mongodb://127.0.0.1:27017/pen_academy

# Allowed CORS origin(s) for the frontend. Comma-separate multiple origins.
CLIENT_URL=http://localhost:5173
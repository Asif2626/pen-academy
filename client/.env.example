# PEN Academy frontend environment template.
# Copy this file to .env (optional in development) and adjust as needed.
# Vite only exposes variables prefixed with VITE_ to the client bundle.

# Base URL of the Express REST API.
#   Development default: "/api" is proxied to http://localhost:5000 by
#   vite.config.js, so no value is required for local development.
#   Production: set to the deployed API origin, e.g.
#   VITE_API_URL=https://api.pen-academy.example/api
VITE_API_URL=/api
